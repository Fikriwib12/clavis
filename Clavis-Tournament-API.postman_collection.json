                            "path": [
                                "api",
                                "v1",
                                "register"
                            ]
                        }
                    },
                    "status": "Unprocessable Content",
                    "code": 422,
                    "_postman_previewlanguage": "json",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n    \"message\": \"Nama pengguna harus terdiri dari 6-15 karakter.\",\n    \"errors\": {\n        \"username\": [\n            \"Nama pengguna harus terdiri dari 6-15 karakter.\"\n        ]\n    }\n}"
                }
            ]
        },
        {
            "name": "2. Login (Dapatkan Token)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "if (pm.response.code === 200) {",
                            "    pm.collectionVariables.set('access_token', pm.response.json().data.access_token);",
                            "}",
                            "",
                            "pm.test('Login berhasil dan token tersimpan', () => {",
                            "    pm.response.to.have.status(200);",
                            "    pm.expect(pm.collectionVariables.get('access_token')).to.not.be.empty;",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "auth": {
                    "type": "noauth"
                },
                "method": "POST",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"username\": \"budi12345\",\n    \"password\": \"rahasia123\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "login"
                    ]
                },
                "description": "Menukar username & password dengan Bearer token. Token otomatis disimpan ke variabel koleksi `access_token`.\n\nSetiap login menerbitkan token baru dan membatalkan token sebelumnya. Setelah 5 kali gagal, login dikunci selama 60 detik."
            },
            "response": [
                {
                    "name": "200 OK",
                    "originalRequest": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/login",
