                    "body": "{\n    \"message\": \"Login berhasil.\",\n    \"data\": {\n        \"token_type\": \"Bearer\",\n        \"access_token\": \"JjK79uJYnxKjVvvCLgXXmdtBVqX2o1IeENsxQWMuhv9Fq5IgeUPbdwcSw1Rt\"\n    }\n}"
                },
