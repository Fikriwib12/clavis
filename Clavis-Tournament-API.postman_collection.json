                    "name": "422 Kata sandi salah",
                    "originalRequest": {
                        "method": "POST",
                        "header": [],
                        "url": {
                            "raw": "{{base_url}}/api/v1/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "api",
                                "v1",
                                "login"
                            ]
                        }
                    },
                    "status": "Unprocessable Content",
                    "code": 422,
                    "_postman_previewlanguage": "json",
                    "header": [
                        {
                            "key": "Content-Type",
                            "value": "application/json"
                        }
                    ],
                    "body": "{\n    \"message\": \"Kata sandi yang Anda masukkan salah.\",\n    \"errors\": {\n        \"password\": [\n            \"Kata sandi yang Anda masukkan salah.\"\n        ]\n    }\n}"
                }
            ]
        },
        {
            "name": "3. Get Candidate Data",
